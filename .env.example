# ============================================================
# DocuMind AI — variáveis de ambiente do BACKEND
# Copie para `.env` na raiz do projeto e preencha. Nunca commite o `.env`.
# As variáveis do frontend ficam em `frontend/.env.local.example`.
# ============================================================

# --- Aplicação ---------------------------------------------
APP_ENV=development            # development | test | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                 # true em produção (logs estruturados em JSON)
CORS_ORIGINS=http://localhost:3000

# --- Banco de dados (Supabase → Project Settings → Database → Connection string) ---
# Use a connection string "Transaction pooler" (porta 6543) ou "Session" (5432).
# O backend converte automaticamente para o driver asyncpg.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# --- Supabase (Project Settings → API) ----------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # usado SOMENTE no backend (storage). Nunca no frontend.
# Opcional: segredo legado HS256 (Project Settings → API → JWT Secret).
# Se vazio, o backend valida tokens via JWKS público do projeto (chaves assimétricas).
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# --- OpenRouter (https://openrouter.ai/settings/keys) -------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelos: consulte https://openrouter.ai/models (chat) e
# https://openrouter.ai/api/v1/embeddings/models (embeddings).
LLM_MODEL=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536             # precisa bater com o modelo; mudar exige nova migração + reprocessamento

# --- Limites de upload/processamento -------------------------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
