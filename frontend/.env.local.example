# Copie para `frontend/.env.local`. Apenas valores PÚBLICOS entram aqui (prefixo NEXT_PUBLIC_).
# A chave "anon" do Supabase é pública por design; o isolamento vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
